erDiagram
    freelancer {
        ObjectId _id PK
        string name
        string email
        float stundensatz
        date registrierungsdatum
        float bewertung
        array faehigkeiten
        ObjectId freelancer_ids FK
    }
    faehigkeit_eingebettet {
        string bezeichnung
        string kategorie
        string erfahrungsstufe
        float nachfrage
    }
    projekte {
        ObjectId _id PK
        string titel
        date startdatum
        date enddatum
        float budget
        string status
        ObjectId kunde_id FK
        ObjectId freelancer_ids FK
    }
    kunden {
        ObjectId _id PK
        string firmenname
        string kontaktperson
        string email
        string branche
        string land
    }

    freelancer ||--|{ FAEHIGKEIT_eingebettet : "eingebettet (keine eigene Collection)"
    projekte }|--|{ freelancer : "referenz"
    projekte }|--|| kunden : "referenz"